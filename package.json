{
  "name": "endurance-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/run.mjs vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run.mjs vitest run",
    "db:migrate:local": "node scripts/run.mjs wrangler d1 migrations apply endurance-os --local",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:integration": "node scripts/run.mjs vitest run tests/api.test.ts",
    "test:e2e": "node scripts/browser-test.mjs",
    "test:pwa": "node scripts/pwa-test.mjs",
    "production:check": "node scripts/production-check.mjs",
    "build:production": "tsc --noEmit && CLOUDFLARE_ENV=production node scripts/run.mjs vite build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
